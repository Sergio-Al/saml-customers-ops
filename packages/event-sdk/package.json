{
  "name": "@ai-ops/event-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Event bus abstraction: publishers, consumers, and contracts.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-ops/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
